# MediQuick AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

NVIDIA_NIM_API_KEY=your_nim_api_key_here          # Get from https://build.nvidia.com
NVIDIA_NIM_MODEL=meta/llama-3.2-90b-vision-instruct   # or meta/llama-3.2-11b-vision-instruct

# NVIDIA's hosted 90B vision model is occasionally oversubscribed and stops responding.
# When that happens the app automatically retries on this smaller sibling model so triage
# keeps working. Leave blank to disable the fallback.
NVIDIA_NIM_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct

# Secret used to sign login tokens. setup.bat replaces this with a unique random
# value on first install. If you edit it by hand, use a long random string —
# never ship the placeholder, or anyone could forge a login token.
JWT_SECRET=CHANGE_ME_GENERATED_AT_SETUP
JWT_EXPIRE_HOURS=168

DATABASE_URL=sqlite:///./mediquick.db
MAX_IMAGE_SIZE_MB=5
MAX_CONTEXT_TURNS=10
LOG_LEVEL=INFO
